# Qdrant connection
QDRANT_HOST=localhost:6333

# Ollama connection (used by agent.py for LLM inference)
OLLAMA_HOST=localhost:11434

# Model identifiers
LLM_MODEL=llama3
EMBED_MODEL=intfloat/multilingual-e5-large

# HuggingFace model cache — bind-mount this into containers so the model
# is not re-downloaded on every run.
HF_HOME=~/.cache/huggingface
