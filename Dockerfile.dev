# CPU-only image for Linux CI / contributors without GPU hardware.
# Mac users: run train.py directly in your venv — Docker cannot access MPS (Apple GPU).
# See README.md for local dev instructions.

FROM python:3.9-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install CPU-only torch first, then the remaining deps.
# typing_extensions is pre-installed from PyPI to avoid a source build triggered
# by the inconsistent wheel metadata on the PyTorch index (flit_core not available there).
RUN pip install --no-cache-dir typing_extensions \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && grep -v "^torch" requirements.txt | pip install --no-cache-dir -r /dev/stdin
