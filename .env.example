# HPC site configuration — copy to .env and fill in your values.
# .env is gitignored and never committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your project account and scratch path
#   source .env
#   sbatch --account="$HPC_ACCOUNT" restart-services-sbatch.sh
#
# SLURM tip: export SBATCH_ACCOUNT="$HPC_ACCOUNT" once in your shell session
# and sbatch will use it automatically without needing --account on every call.

HPC_ACCOUNT=project_465003209
HPC_SCRATCH=/scratch/project_465003209/mcgowank/
